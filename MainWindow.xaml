<Window x:Class="MilkillaDropVJ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Milkilla Drop VJ — Hito 1: BeatDrop + Spout"
        Width="1100" Height="760" MinWidth="760" MinHeight="520"
        Background="#18181C" Foreground="Gainsboro"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#3A3A44" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- BeatDrop -->
        <GroupBox Header="BeatDrop" DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Ejecutable:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="PathBox" Grid.Column="1" VerticalContentAlignment="Center" MinHeight="26"
                         LostFocus="PathBox_LostFocus" />
                <Button Grid.Column="2" Content="Buscar…" Margin="8,0,0,0" Click="Browse_Click" />

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="LaunchButton" Content="▶ Lanzar BeatDrop" Click="Launch_Click" />
                    <Button x:Name="StopButton" Content="■ Cerrar BeatDrop" Click="Stop_Click" />
                    <Button x:Name="ToggleSpoutButton" Content="Alternar Spout en BeatDrop (Ctrl+Z)"
                            Click="ToggleSpout_Click"
                            ToolTip="Pone BeatDrop delante y le manda Ctrl+Z, que activa o desactiva su salida Spout." />
                    <CheckBox x:Name="CloseOnExitBox" Content="Cerrar BeatDrop al salir" Foreground="Gainsboro"
                              VerticalAlignment="Center" Margin="8,0,16,0"
                              Checked="CloseOnExit_Changed" Unchecked="CloseOnExit_Changed" />
                    <TextBlock x:Name="BeatDropStatus" VerticalAlignment="Center" Text="Parado" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Spout -->
        <GroupBox Header="Spout" DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Emisor:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SenderBox" Width="300" MinHeight="26" SelectionChanged="SenderBox_SelectionChanged" />
                <Button Content="Automático" Margin="8,0,8,0" Click="AutoSender_Click"
                        ToolTip="Olvida el emisor elegido a mano y vuelve a elegir solo (BeatDrop primero)." />
                <TextBlock x:Name="SpoutStatus" VerticalAlignment="Center" Text="Buscando emisores…" />
            </StackPanel>
        </GroupBox>

        <!-- Registro -->
        <GroupBox Header="Registro" DockPanel.Dock="Bottom" Height="140" Margin="0,8,0,0">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Background="#101014" Foreground="#B8B8C0" BorderThickness="0" />
        </GroupBox>

        <!-- Vista previa -->
        <Border Background="Black" BorderBrush="#3A3A44" BorderThickness="1">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
                <TextBlock x:Name="NoSignalText" Text="Sin señal Spout"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="28" Foreground="#55555F" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
